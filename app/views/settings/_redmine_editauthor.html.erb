<% settings = RedmineEditauthor::Settings %>

<fieldset>
  <p id="author_scope">
    <label for="settings_authors_scope"><%= l(:label_editauthor_authors_scope) %></label>
    <%= select_tag('settings[authors_scope]',
                   options_for_select([[l(:option_editauthor_project_add_issues), 'project_add_issues'],
                                       [l(:option_editauthor_any_role), 'any_role'],
                                       [l(:option_editauthor_project_members), 'project_members']],
                                      RedmineEditauthor::Hook::ViewListener::AUTHORS_SCOPES.include?(settings.authors_scope) ? settings.authors_scope : (settings.members_scope? ? 'project_members' : 'project_add_issues')),
                   id: 'settings_authors_scope') %>
    <em class="info"><%= l(:text_editauthor_authors_scope) %></em>
  </p>
</fieldset>
